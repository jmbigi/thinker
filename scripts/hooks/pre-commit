#!/usr/bin/env bash
# Verificación previa al commit (P1.1, P1.9). Escape: git commit --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] ruff check"
if command -v ruff >/dev/null 2>&1; then
    ruff check .
else
    echo "  ruff no instalado: OMITIDO"
fi

echo "[pre-commit] scan-secrets"
bash scripts/scan-secrets.sh

echo "[pre-commit] py_compile"
for f in *.py scripts/*.py holdout/*.py; do
    [ -e "$f" ] || continue
    python3 -m py_compile "$f"
done

echo "[pre-commit] preflight"
python3 scripts/preflight.py

echo "[pre-commit] docs-check"
python3 scripts/check_docs.py

echo "[pre-commit] unittest"
if [ -d tests ]; then
    python3 -m unittest discover -s tests -q
else
    echo "  no existe tests/: OJO, suite no ejecutada" >&2
    exit 1
fi

echo "[pre-commit] audit-changes (solo bloqueos altos)"
python3 scripts/audit_changes.py --staged --fallar-en bloquear

echo "[pre-commit] holdout (hashes + tests)"
python3 scripts/run_holdout.py

echo "[pre-commit] OK"
