# Copia este archivo a .env y rellena tu clave (nunca comitees .env)
OPENROUTER_API_KEY=

# Opcional: modelo gratuito de OpenRouter (":free" = coste 0).
# Por defecto: poolside/laguna-xs-2.1:free
OPENROUTER_MODEL=poolside/laguna-xs-2.1:free

# Opcionales para otros proveedores
# OPENAI_API_KEY=
# KILO_API_KEY=
# KILO_MODEL=cohere/north-mini-code:free   # sin key: 200 req/h por IP
# DEEPSEEK_API_KEY=

# Opcional: endpoint loopback de deepseek-free-agent (requiere autorización por uso).
DEEPSEEK_AGENT_URL=http://127.0.0.1:9527

# Free AI Gateway (ia.forthtrade.com) — una sola API key del gateway; no claves upstream
# FT_AI_API_KEY=
# FORTHTRADE_BASE_URL=https://ia.forthtrade.com/v1
# FORTHTRADE_MODEL=auto
