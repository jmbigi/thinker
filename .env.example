# Copia este archivo a .env y rellena tu clave (nunca comitees .env)
OPENROUTER_API_KEY=

# Opcional: modelo gratuito de OpenRouter (":free" = coste 0).
# Por defecto: nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Opcionales para otros proveedores
# OPENAI_API_KEY=
# KILO_API_KEY=
