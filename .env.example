# Copia este archivo a .env y rellena tu clave (nunca comitees .env)
OPENROUTER_API_KEY=

# Opcional: modelo gratuito de OpenRouter (":free" = coste 0).
# Por defecto: poolside/laguna-xs-2.1:free
OPENROUTER_MODEL=poolside/laguna-xs-2.1:free

# Opcionales para otros proveedores
# OPENAI_API_KEY=
# KILO_API_KEY=
# DEEPSEEK_API_KEY=
